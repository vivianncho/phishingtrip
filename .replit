modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "companion-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-lifecycle"

[[workflows.workflow]]
name = "companion-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox test && pnpm --filter @workspace/mockup-sandbox run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-lifecycle"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/stillwater-mobile test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
CORS_ORIGINS = "https://d2989347-2ac9-4d89-bae7-38ae2a5272e1-00-18w376doj2nqo.expo.worf.replit.dev"
