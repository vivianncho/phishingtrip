@@ -75272,7 +75272,12 @@ var pushSchema = async (imports, drizzleInstance, schemaFilters, tablesFilter, e
   );
   const db = {
     query: async (query, params) => {
-      const res = await drizzleInstance.execute(sql.raw(query));
+      // Preserve introspection bindings, including composite primary-key queries.
+      const statement = params?.length
+        ? sql.join(query.split(/(\$\d+)/g).map((part) =>
+            /^\$\d+$/.test(part) ? sql`${params[Number(part.slice(1)) - 1]}` : sql.raw(part)), sql.raw(""))
+        : sql.raw(query);
+      const res = await drizzleInstance.execute(statement);
       return res.rows;
     }
   };
