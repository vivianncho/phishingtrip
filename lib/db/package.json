{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./countries": "./src/countries.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "countries:check": "tsx src/country-constraints-cli.ts check",
    "countries:upgrade": "tsx src/country-constraints-cli.ts upgrade",
    "push": "tsx src/push.ts",
    "push-force": "tsx src/push.ts --force",
    "test": "tsx --test src/*.test.ts && node --test security/*.test.mjs",
    "access:check": "node security/check-api-access.mjs",
    "access:configure": "node security/configure-access.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:"
  }
}
